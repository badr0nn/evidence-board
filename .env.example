# Salin file ini menjadi ".env" lalu isi dengan kredensial dari Google Cloud Console.
# JANGAN commit file ".env" (berisi kredensial) ke repository publik.

VITE_GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---------------------------------------------------------------------------
# Basic Auth untuk middleware.js (dibaca oleh Vercel Edge Middleware).
# Set variabel ini di Vercel Dashboard -> Project Settings -> Environment
# Variables (untuk deployment produksi), bukan hanya di .env lokal.
# Jika tidak diisi, middleware.js akan memakai fallback: admin / Siber2026
# ---------------------------------------------------------------------------
AUTH_USER=admin
AUTH_PASS=Siber2026
